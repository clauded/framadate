# Enables "clean URLs" (URL_PROPRE = true in app/inc/config.php).
#
# Without this file, links generated by the app such as
#   https://yourdomain/framadate/{poll_id}/admin
#   https://yourdomain/framadate/{poll_id}
# have nothing to route them to adminstuds.php / studs.php and will 404.
# If you don't want clean URLs, you can instead set URL_PROPRE = false in
# app/inc/config.php and delete this file - either approach works, just
# keep the two in sync.
#
# If Framadate lives in a subdirectory (e.g. https://yourdomain/framadate/),
# uncomment and adjust the RewriteBase line below to match.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /framadate/

    # Don't rewrite requests that already map to a real file or directory
    # (css/, js/, images/, admin/, vendor/, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Poll admin link: {poll_id}/admin
    RewriteRule ^([a-zA-Z0-9-]+)/admin/?$ adminstuds.php?poll=$1 [L,QSA]

    # Edit an existing vote: {poll_id}/vote/{vote_id}
    RewriteRule ^([a-zA-Z0-9-]+)/vote/([a-zA-Z0-9_-]+)/?$ studs.php?poll=$1&vote=$2 [L,QSA]

    # Poll action with a value: {poll_id}/action/{action}/{value}
    RewriteRule ^([a-zA-Z0-9-]+)/action/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_=-]+)/?$ studs.php?poll=$1&$2=$3 [L,QSA]

    # Poll action without a value: {poll_id}/action/{action}
    RewriteRule ^([a-zA-Z0-9-]+)/action/([a-zA-Z0-9_-]+)/?$ studs.php?poll=$1&$2= [L,QSA]

    # Plain poll link: {poll_id}
    RewriteRule ^([a-zA-Z0-9-]+)/?$ studs.php?poll=$1 [L,QSA]
</IfModule>
